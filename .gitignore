# ── Build output ────────────────────────────────────────────────
# Regenerated by Maven on every build. Never commit.
target/

# ── IDE ─────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.classpath
.project
.settings/

# ── OS junk ─────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini

# ── Secrets — NEVER commit ──────────────────────────────────────
# API keys come from environment variables (TWELVEDATA_API_KEY,
# FINNHUB_API_KEY), never from a file in the repo. If you need local
# overrides, use one of these filenames so it stays ignored.
.env
*.env
application-local.yml
application-local.properties
application-secret.yml

# ── Local backups / scratch ─────────────────────────────────────
_local-backup/
static_old/
static-old/
*.bak
*.orig

# ── Internal working docs (not part of the deliverable) ─────────
# Team instruction files. The docs a fresh clone actually needs are
# README.md, CONTRIBUTING.md and backend/CONTRACTS.md — those stay.
Isna_Instructions.txt
Glenn_instructions.txt
*_Instructions.txt
*_instructions.txt

# ── Logs ────────────────────────────────────────────────────────
*.log
out.txt
